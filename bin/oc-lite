#!/usr/bin/env bash
# oc-lite — launcher nhẹ cho opencode (Termux / PRoot Ubuntu / Linux)
# Tự tìm HOME + binary, không hardcode /root.
set -u

HOME_DIR="${HOME:-$(eval echo ~)}"
CONFIG_FILE="$HOME_DIR/.config/opencode/opencode.json"

# Tìm binary opencode ở các vị trí phổ biến (Termux + Linux)
BIN=""
for c in "$HOME_DIR/.opencode/bin/opencode" "$HOME_DIR/.local/bin/opencode" "$PREFIX/bin/opencode"; do
  if [ -x "$c" ]; then BIN="$c"; break; fi
done
if [ -z "$BIN" ]; then
  BIN="$(command -v opencode 2>/dev/null || true)"
fi
if [ -z "$BIN" ]; then
  echo "[oc-lite] Không tìm thấy opencode. Cài: https://opencode.ai/docs (curl -fsSL https://opencode.ai/install | bash)" >&2
  exit 1
fi

export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$CONFIG_FILE}"
export DO_NOT_TRACK=1
export NODE_NO_WARNINGS=1
# Termux RAM ít -> giảm song song, giảm thread để đỡ lag/nóng máy
if [ -n "${PREFIX:-}" ] && [ -d "/data/data/com.termux" ]; then
  export BUN_CONFIG_MAX_HTTP_REQUESTS=2
  export UV_THREADPOOL_SIZE=1
else
  export BUN_CONFIG_MAX_HTTP_REQUESTS=4
  export UV_THREADPOOL_SIZE=2
fi

# Cảnh báo RAM yếu (hỗ trợ cả Termux không có lệnh free)
if command -v free >/dev/null 2>&1; then
  AVAIL=$(free -m 2>/dev/null | awk '/^Mem:/{print $7}')
  if [ -n "${AVAIL:-}" ] && [ "$AVAIL" -lt 500 ]; then
    echo "[oc-lite] RAM trống thấp (${AVAIL}MB). Nên dùng: oc-lite run \"task\" thay vì TUI."
  fi
fi

case "${1:-}" in
  run)
    shift
    # run không TUI = nhẹ nhất cho Termux
    exec "$BIN" run "$@"
    ;;
  full)
    shift
    exec "$BIN" "$@"
    ;;
  models)
    # liệt kê nhanh model free opencode Zen
    echo "Free (opencode Zen): big-pickle, deepseek-v4-flash-free,"
    echo "  mimo-v2.5-free, ling-3.0-flash-fin-free,"
    echo "  nemotron-3-ultra-free, nemotron-3.5-lightning-free,"
    echo "  muse-spark-1.2/1.3-contributor-free"
    echo "Đổi trong TUI: /models  hoặc  /connect để login opencode."
    ;;
  *)
    exec "$BIN" "$@"
    ;;
esac
