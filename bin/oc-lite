#!/usr/bin/env bash
# oc-lite — launcher siêu nhẹ cho Termux (chỉ build code)
# --pure: tắt plugin ngoài | run: không TUI (nhẹ nhất)
set -u

HOME_DIR="${HOME:-$(eval echo ~)}"
CONFIG_FILE="$HOME_DIR/.config/opencode/opencode.json"

BIN=""
for c in "$HOME_DIR/.opencode/bin/opencode" "$HOME_DIR/.local/bin/opencode" "${PREFIX:-/nonexistent}/bin/opencode"; do
  if [ -x "$c" ]; then BIN="$c"; break; fi
done
if [ -z "$BIN" ]; then BIN="$(command -v opencode 2>/dev/null || true)"; fi
if [ -z "$BIN" ]; then
  echo "[oc-lite] Chưa có opencode. Cài: curl -fsSL https://opencode.ai/install | bash" >&2
  exit 1
fi

export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$CONFIG_FILE}"
export DO_NOT_TRACK=1
export NODE_NO_WARNINGS=1
# Tắt cái nặng gây lag trên Termux
export OPENCODE_DISABLE_AUTOUPDATE=true
export OPENCODE_DISABLE_DEFAULT_PLUGINS=true
export OPENCODE_DISABLE_LSP_DOWNLOAD=true
export OPENCODE_DISABLE_MOUSE=true
export OPENCODE_DISABLE_TERMINAL_TITLE=true
export OPENCODE_DISABLE_CLAUDE_CODE=true
export OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=true
export OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=30000
# Termux RAM ít -> giảm song song
if [ -d "/data/data/com.termux" ]; then
  export BUN_CONFIG_MAX_HTTP_REQUESTS=2
  export UV_THREADPOOL_SIZE=1
  export GOMAXPROCS=2
else
  export BUN_CONFIG_MAX_HTTP_REQUESTS=4
  export UV_THREADPOOL_SIZE=2
fi

if command -v free >/dev/null 2>&1; then
  AVAIL=$(free -m 2>/dev/null | awk '/^Mem:/{print $7}')
  if [ -n "${AVAIL:-}" ] && [ "$AVAIL" -lt 500 ]; then
    echo "[oc-lite] RAM trống ${AVAIL}MB. Nên dùng: oc-lite run \"task\" (nhẹ nhất)."
  fi
fi

case "${1:-}" in
  run)
    shift
    # nhẹ nhất: không TUI, không plugin
    exec "$BIN" --pure run "$@"
    ;;
  full)
    shift
    exec "$BIN" "$@"
    ;;
  models)
    echo "Free build-code (opencode Zen): deepseek-v4-flash-free (chính),"
    echo "  nemotron-3.5-lightning-free (phụ/nhẹ), big-pickle,"
    echo "  mimo-v2.5-free, ling-3.0-flash-fin-free, nemotron-3-ultra-free"
    echo "Đổi trong TUI: /models | login: /connect -> opencode"
    ;;
  *)
    # TUI nhẹ: --pure tắt plugin ngoài
    exec "$BIN" --pure "$@"
    ;;
esac
