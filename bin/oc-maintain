#!/usr/bin/env bash
# oc-maintain — dọn dẹp opencode cho máy yếu (Termux / Linux)
# Không hardcode /root, chạy an toàn khi DB chưa có hoặc opencode đang chạy.
set -u

HOME_DIR="${HOME:-$(eval echo ~)}"
DATA_DIR="$HOME_DIR/.local/share/opencode"
DB="$DATA_DIR/opencode.db"
LOG="$DATA_DIR/log/opencode.log"
TMP_LOG="${TMPDIR:-/tmp}/oc.log"

is_running() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "opencode" >/dev/null 2>&1
  else
    ps aux 2>/dev/null | grep -q "[o]pencode"
  fi
}

rotate_log() {
  if [ -f "$LOG" ]; then
    tail -200 "$LOG" > "$TMP_LOG" 2>/dev/null && cat "$TMP_LOG" > "$LOG" 2>/dev/null || true
  fi
}

clear_cache() {
  rm -rf "$DATA_DIR/tool-output/"* "$HOME_DIR/.cache/opencode/models.json" 2>/dev/null || true
}

if is_running; then
  echo "[oc-maintain] opencode đang chạy. Chỉ xoay log + xóa cache..."
  rotate_log
  clear_cache
  echo "[oc-maintain] xong."
  exit 0
fi

if [ ! -f "$DB" ]; then
  echo "[oc-maintain] Chưa có DB ($DB). Chỉ xoay log + xóa cache..."
  rotate_log
  clear_cache
  echo "[oc-maintain] xong."
  exit 0
fi

echo "[oc-maintain] DB trước: $(du -h "$DB" 2>/dev/null | cut -f1)"
python3 - "$DB" <<'EOF'
import sqlite3, sys
path = sys.argv[1]
try:
    con = sqlite3.connect(path, timeout=30)
    cur = con.cursor()
    try:
        cur.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        print("checkpoint:", cur.fetchone())
    except Exception as e:
        print("checkpoint skip:", e)
    con.execute("VACUUM")
    con.commit()
    print("vacuum xong")
    con.close()
except Exception as e:
    print("vacuum lỗi:", e)
    sys.exit(1)
EOF
rotate_log
clear_cache
echo "[oc-maintain] DB sau: $(du -h "$DB" 2>/dev/null | cut -f1)"

if [ "${1:-}" = "--prune" ]; then
  echo "--- session mới nhất ---"
  python3 - "$DB" <<'EOF'
import sqlite3, sys
try:
    con = sqlite3.connect(sys.argv[1], timeout=10)
    cur = con.cursor()
    # Lấy danh sách bảng để tương thích nhiều schema opencode
    tables = {r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    if "session" in tables:
        cols = [r[1] for r in cur.execute("PRAGMA table_info(session)")]
        if "title" in cols:
            for r in cur.execute("SELECT id, substr(title,1,40), updated_at FROM session ORDER BY updated_at DESC LIMIT 5"):
                print(r[0], "|", r[1])
        else:
            for r in cur.execute("SELECT id FROM session LIMIT 5"):
                print(r[0])
    else:
        print("(không tìm thấy bảng session)")
    con.close()
except Exception as e:
    print("prune lỗi:", e)
EOF
fi
