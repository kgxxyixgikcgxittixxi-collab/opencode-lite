{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "enabled_providers": ["opencode"],
  "provider": {
    "opencode": {
      "options": {
        "timeout": 30000,
        "chunkTimeout": 15000
      }
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "*.log",
      ".cache/**",
      "__pycache__/**",
      ".venv/**",
      "*.db*",
      "coverage/**",
      ".next/**",
      "vendor/**",
      "*.tmp",
      "*.temp"
    ]
  },
  "mcp": {},
  "server": {
    "hostname": "127.0.0.1"
  },
  "subagent_depth": 0,
  "default_agent": "build"
}
