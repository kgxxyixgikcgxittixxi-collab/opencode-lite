{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "enabled_providers": ["opencode"],
  "provider": {
    "opencode": {
      "options": {
        "timeout": 60000,
        "chunkTimeout": 30000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "*.log",
      ".cache/**",
      "__pycache__/**",
      ".venv/**",
      "*.db-wal",
      "*.db-shm",
      "coverage/**"
    ]
  },
  "mcp": {},
  "server": {
    "hostname": "127.0.0.1"
  },
  "subagent_depth": 0,
  "default_agent": "build"
}
